# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me
# openssl rand -hex 32
SECRET_KEY=change-me
# true once the site is served over HTTPS
COOKIE_SECURE=false
# The address people open the site at (no trailing slash). Sign-in providers send people back to
# $PUBLIC_URL/api/auth/oauth/<google|microsoft|apple>/callback, so register exactly that URL with each provider.
PUBLIC_URL=http://localhost:3000

# --- Sign in with Google: console.cloud.google.com > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# --- Sign in with Microsoft: entra.microsoft.com > App registrations > New registration (Web platform), then a client secret
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
# --- Sign in with Apple: developer.apple.com > Identifiers > Services ID (with Sign in with Apple) and a key (.p8).
#     Apple only accepts HTTPS callback addresses, so this works once the site has a real domain.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# the .p8 file's contents on one line, with \n for each line break
APPLE_PRIVATE_KEY=
# Only used by `python -m app.cli generate-challenge` (offline authoring). The running site never calls OpenAI.
OPENAI_API_KEY=
